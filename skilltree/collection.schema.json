{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-spells.local/skilltree/collection.schema.json",
  "title": "Skill Collection Work Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["collection_id", "version", "skills"],
  "properties": {
    "collection_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/skill"}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "locator"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "minLength": 1}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "point_cost", "requires", "artifact"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "point_cost": {"type": "integer", "minimum": 0},
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "artifact": {"$ref": "#/$defs/artifact"},
        "lesson_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
