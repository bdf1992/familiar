{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentspells.dev/schema/spell-frontmatter-0.2.json",
  "title": "Agent Spells SPELL.md frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["spell_format", "name", "version", "description", "telemetry", "limits", "effects"],
  "properties": {
    "spell_format": {"const": "0.2"},
    "name": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 1024},
    "telemetry": {"type": "array", "items": {"$ref": "#/$defs/telemetry"}},
    "limits": {"type": "array", "items": {"$ref": "#/$defs/limit"}},
    "effects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/effect"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "telemetry": {"type": "object", "additionalProperties": false, "required": ["id", "description"], "properties": {"id": {"$ref": "#/$defs/id"}, "description": {"type": "string", "minLength": 1}, "max_age_ms": {"type": "integer", "minimum": 0}}},
    "limit": {"type": "object", "additionalProperties": false, "required": ["id", "description"], "properties": {"id": {"$ref": "#/$defs/id"}, "description": {"type": "string", "minLength": 1}}},
    "requirement": {"type": "object", "additionalProperties": false, "required": ["id", "phase", "description"], "properties": {"id": {"$ref": "#/$defs/id"}, "phase": {"enum": ["before", "after"]}, "description": {"type": "string", "minLength": 1}}},
    "effect": {"type": "object", "additionalProperties": false, "required": ["id", "description", "telemetry", "requirements", "limits", "authority"], "properties": {"id": {"$ref": "#/$defs/id"}, "description": {"type": "string", "minLength": 1}, "telemetry": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}, "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}}, "limits": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}, "authority": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}}
  }
}
