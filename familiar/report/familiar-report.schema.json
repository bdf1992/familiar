{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentspells.dev/schema/familiar-report-0.1.json",
  "title": "Agent Spells Familiar Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_format", "subject", "projection", "authority", "evidence"],
  "properties": {
    "report_format": {"const": "0.1"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "caster_id", "revision", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "caster_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "generated_for", "guidance"],
      "properties": {
        "policy": {"type": "string", "minLength": 1},
        "generated_for": {"type": "string", "minLength": 1},
        "guidance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dialect": {"type": "string"},
            "attention": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "preferences": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "stake": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "omitted": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["advisory_only"],
      "properties": {
        "advisory_only": {"const": true},
        "reported_ceiling": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_digest_verified"],
      "properties": {
        "subject_digest_verified": {"type": "boolean"},
        "accepted_by_subject": {"type": "boolean"},
        "observations": {
          "type": "array",
          "items": {"type": "object"}
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "status"],
            "properties": {
              "claim": {"type": "string", "minLength": 1},
              "status": {"enum": ["asserted", "supported", "defeated", "unknown"]},
              "evidence_refs": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
