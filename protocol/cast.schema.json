{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://familiar.dev/schema/cast.schema.json",
  "title": "Spell Cast",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cast_id",
    "spell",
    "caster",
    "intent",
    "expression",
    "telemetry",
    "requirements",
    "limits",
    "energy",
    "status"
  ],
  "properties": {
    "cast_id": {"type": "string", "minLength": 1},
    "spell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "caster": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["human", "agent", "system", "organization", "other"]}
      }
    },
    "familiars": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "role"],
        "properties": {
          "id": {"type": "string"},
          "role": {"type": "string", "enum": ["primary", "advisory", "system"]},
          "stake": {"type": "string"}
        }
      }
    },
    "target": {},
    "intent": {"type": "string", "minLength": 1},
    "expression": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "telemetry": {
      "type": "array",
      "items": {"$ref": "#/$defs/telemetryObservation"}
    },
    "inferences": {
      "type": "array",
      "items": {"$ref": "#/$defs/derivedValue"}
    },
    "assumptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/derivedValue"}
    },
    "requirements": {
      "type": "array",
      "items": {"$ref": "#/$defs/check"}
    },
    "limits": {
      "type": "array",
      "items": {"$ref": "#/$defs/check"}
    },
    "energy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "committed"],
      "properties": {
        "available": {"type": "object", "additionalProperties": true},
        "committed": {"type": "object", "additionalProperties": true}
      }
    },
    "expected_effect": {},
    "actual_effect": {},
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceItem"}
    },
    "residuals": {
      "type": "array",
      "items": {"type": "string"}
    },
    "status": {
      "type": "string",
      "enum": ["invoked", "ready", "blocked", "casting", "resolved", "failed"]
    }
  },
  "$defs": {
    "telemetryObservation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "value", "source"],
      "properties": {
        "id": {"type": "string"},
        "value": {},
        "source": {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind"],
          "properties": {
            "kind": {"type": "string"},
            "locator": {"type": "string"}
          }
        },
        "observed_at": {"type": "string", "format": "date-time"},
        "coverage": {"type": "string"},
        "freshness_ms": {"type": "integer", "minimum": 0}
      }
    },
    "derivedValue": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "value"],
      "properties": {
        "id": {"type": "string"},
        "value": {},
        "basis": {"type": "array", "items": {"type": "string"}}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"type": "string"},
        "status": {"type": "string", "enum": ["satisfied", "missing", "uncertain", "exceeded", "not-applicable"]},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"}
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string"},
        "locator": {"type": "string"},
        "summary": {"type": "string"}
      }
    }
  }
}
