{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://familiar.dev/schema/spell.schema.json",
  "title": "Spell Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["spell_protocol", "identity", "invocation", "telemetry", "requirements", "limits", "energy", "effect", "evidence", "evaluation"],
  "properties": {
    "spell_protocol": {"const": "0.1"},
    "identity": {
      "type": "object",
      "required": ["id", "name", "version", "inherent_ability"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
        "description": {"type": "string"},
        "inherent_ability": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "invocation": {
      "type": "object",
      "required": ["expressions"],
      "properties": {
        "magic_words": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "expressions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/namedDescription"}}
      },
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "required": ["required", "optional"],
      "properties": {
        "required": {"type": "array", "items": {"$ref": "#/$defs/telemetry"}},
        "optional": {"type": "array", "items": {"$ref": "#/$defs/telemetry"}}
      },
      "additionalProperties": false
    },
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/namedDescription"}},
    "limits": {"type": "array", "items": {"$ref": "#/$defs/limit"}},
    "energy": {
      "type": "object",
      "required": ["resources"],
      "properties": {"resources": {"type": "array", "items": {"$ref": "#/$defs/energy"}}},
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": ["description"],
      "properties": {"description": {"type": "string", "minLength": 1}, "schema": {"type": "object"}},
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["required"],
      "properties": {"required": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/namedDescription"}}},
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": ["trials"],
      "properties": {
        "claimed_level": {"type": "integer", "minimum": 0, "maximum": 9},
        "trials": {"type": "array", "items": {"$ref": "#/$defs/trial"}}
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "agent_skill": {"type": "boolean"},
        "skill_path": {"type": "string"},
        "mcp": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "namedDescription": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "name": {"type": "string"},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "description": {"type": "string", "minLength": 1},
        "coverage": {"type": "string"},
        "max_age_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "limit": {
      "type": "object",
      "required": ["id", "description", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "description": {"type": "string", "minLength": 1},
        "kind": {"enum": ["authority", "scope", "resource", "consequence", "reversibility", "identity", "other"]}
      },
      "additionalProperties": false
    },
    "energy": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "description": {"type": "string", "minLength": 1},
        "unit": {"type": "string"}
      },
      "additionalProperties": false
    },
    "trial": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "description": {"type": "string", "minLength": 1},
        "proves": {
          "type": "array",
          "items": {
            "enum": ["effect", "evidence", "telemetry-sensitive", "requirements", "limits", "energy-scaling", "graceful-blocking", "multi-expression", "multi-environment", "long-horizon", "reversibility"]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
